{
  "id": "workflow-governance",
  "name": "Workflow Governance",
  "description": "Bind formal plans, three independent complete reviews, execution, acceptance and one final notification to official Task Flow state.",
  "version": "1.2.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agents": { "type": "array", "items": { "type": "string" }, "default": ["housekeeper", "ops", "coder", "reviewer", "life", "companion-dugu", "companion-wu", "companion-lv"] },
      "riskAgentId": { "type": "string", "default": "ops", "description": "Legacy single risk agent setting." },
      "riskAgentIds": { "type": "array", "items": { "type": "string" }, "default": ["ops", "coder"] },
      "decisionAgentId": { "type": "string", "default": "housekeeper" },
      "controllerSessionKey": { "type": "string", "default": "agent:housekeeper:task-system" },
      "ownerTelegramId": { "type": "string" },
      "ownerSessionKey": { "type": "string" },
      "riskStatePath": { "type": "string" },
      "taskStatePath": { "type": "string" }
    }
  },
  "activation": { "onStartup": true },
  "contracts": { "tools": ["workflow_governance"] },
  "toolMetadata": { "workflow_governance": { "optional": true } }
}
