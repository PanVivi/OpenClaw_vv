{
  "id": "housekeeper-workboard-control",
  "name": "Housekeeper Workboard Control",
  "version": "1.1.0",
  "description": "Allow only the housekeeper agent to call the official Workboard dispatcher and inspect a card through in-process Gateway RPC without granting general exec or launching the CLI.",
  "contracts": {
    "tools": [
      "housekeeper_workboard_start",
      "housekeeper_workboard_show"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agentId": {
        "type": "string",
        "default": "housekeeper"
      },
      "boardId": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$",
        "default": "task-system"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 5000,
        "maximum": 60000,
        "default": 30000
      }
    }
  }
}
