{
  "id": "task-system-control",
  "name": "Task System Control",
  "description": "Durable Telegram intake, workflow routing, Workboard/Task Flow linkage, module receipts, cross-role handoffs and delivery receipts.",
  "version": "1.0.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "statePath": { "type": "string" },
      "boardId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$", "default": "task-system" },
      "ownerTelegramId": { "type": "string" },
      "controllerSessionKey": { "type": "string", "default": "agent:housekeeper:task-system" },
      "gatewayTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000, "default": 15000 },
      "agents": {
        "type": "object",
        "additionalProperties": { "type": "string" },
        "default": {
          "housekeeper": "housekeeper",
          "ops": "default",
          "life": "life"
        }
      },
      "targetSessions": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    }
  },
  "activation": { "onStartup": true },
  "contracts": { "tools": ["task_intake", "task_handoff", "task_module"] },
  "toolMetadata": {
    "task_intake": { "optional": true },
    "task_handoff": { "optional": true },
    "task_module": { "optional": true }
  }
}
